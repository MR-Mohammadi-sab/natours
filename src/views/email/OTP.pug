extends baseEmail

block content
  p Hi #{firstName},

  p Welcome to Natours! We're glad to have you 🎉🙏

  p Please use the following verification code to verify your email address:

  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  p(style='font-size: 32px; font-weight: bold; letter-spacing: 8px; margin: 0;')
                    #{url}

  p This verification code will expire in 10 minutes.

  p If you didn't create an account with Natours, you can safely ignore this email.

  p - Mohammad Asif, CEO